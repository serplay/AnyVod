# AnyVod environment variables (used by docker compose and the backend).

# Required. Get a key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# "development" also allows CORS from localhost:5173/3000.
ENVIRONMENT=development

# Comma-separated extra CORS origins (your deployed frontend URL in production).
FRONTEND_ORIGIN=http://localhost:5173

# Embed provider domain used to build player URLs.
VIDSRC_EMBED_DOMAIN=vidsrc.sh

# Backend log filter.
RUST_LOG=info

# Frontend build-time API base URL (leave empty for same-origin in production).
VITE_API_BASE=http://localhost:8000

# Frontend build-time embed provider origin (player iframes). Keep the CSP frame-src in step.
# VITE_EMBED_BASE=https://vidsrc.sh

# Backend per-IP rate limit (token bucket). 0 disables.
# RATE_LIMIT_PER_SEC=10
# RATE_LIMIT_BURST=60
